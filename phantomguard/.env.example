DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# Needed for the generative postmortem via Amazon Bedrock.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
